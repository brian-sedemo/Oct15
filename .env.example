# Project SNOW — environment template
# Copy to .env and populate from the FMG vault: vault.nimbus.ai/fmg/snow
# CONFIDENTIAL — do not share populated values.

# --- Compute / cloud ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
